{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": false,
  "lsp": true,
  "formatter": true,
  "plugin": [
    "oh-my-openagent@latest"
  ],
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  }
}
