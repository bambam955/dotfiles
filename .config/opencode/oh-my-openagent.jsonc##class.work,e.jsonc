{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.6-luna",
      "variant": "high"
    },
    "hephaestus": {
      "model": "openai/gpt-5.5",
      "variant": "medium"
    },
    "oracle": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium"
    },
    "librarian": {
      "model": "opencode/big-pickle"
    },
    "explore": {
      "model": "opencode/big-pickle"
    },
    "multimodal-looker": {
      "model": "opencode/big-pickle",
      "fallback_models": [
        {
          "model": "openai/gpt-5.6-luna"
        }
      ]
    },
    "prometheus": {
      "model": "openai/gpt-5.5",
      "variant": "high"
    },
    "metis": {
      "model": "openrouter/google/gemini-2.5-flash-lite",
      "variant": "high"
    },
    "momus": {
      "model": "openai/gpt-5.6-luna",
      "variant": "xhigh"
    },
    "atlas": {
      "model": "openai/gpt-5.6-luna",
      "variant": "medium"
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5.6-luna",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "openai/gpt-5.4-mini",
          "variant": "medium"
        }
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "openai/gpt-5.6-luna",
      "variant": "medium"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "deep": {
      "model": "openai/gpt-5.6-luna",
      "variant": "high"
    },
    "artistry": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "quick": {
      "model": "opencode/big-pickle"
    },
    "unspecified-low": {
      "model": "openrouter/google/gemini-2.5-flash-lite"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.6-luna",
      "variant": "medium"
    },
    "writing": {
      "model": "openai/gpt-5.6-luna",
      "variant": "medium"
    }
  }
}
